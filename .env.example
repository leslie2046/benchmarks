# Copy this file to .env, then replace only the placeholder values.
# LLM streaming benchmarks (provider keys use the variables below)
# LLM_MODEL=Qwen/Qwen3-8B
# VLLM_LLM_URL=http://127.0.0.1:8000/v1/chat/completions
# XINFERENCE_LLM_URL=http://127.0.0.1:9997/v1/chat/completions
# .env is ignored by Git; never commit real credentials.

# Xinference / OpenAI-compatible embedding benchmark
EMBEDDING_API_KEY=replace-with-your-api-key
EMBEDDING_BASE_URL=https://your-xinference-host:port/v1/embeddings
EMBEDDING_MODEL=bge-m3

# vLLM embedding and reranker benchmarks (uncomment VLLM_API_KEY only if configured)
# VLLM_API_KEY=replace-with-your-api-key
VLLM_EMBEDDING_URL=http://127.0.0.1:8000/v1/embeddings
VLLM_EMBEDDING_MODEL=BAAI/bge-m3
VLLM_RERANK_URL=http://127.0.0.1:8000/v1/rerank
VLLM_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Xinference reranker benchmark
XINFERENCE_API_KEY=replace-with-your-api-key
XINFERENCE_RERANK_URL=https://your-xinference-host:port/v1/rerank
XINFERENCE_RERANK_MODEL=bge-reranker-large

# Xinference audio transcription benchmark
XINFERENCE_AUDIO_URL=https://your-xinference-host:port/v1/audio/transcriptions
XINFERENCE_AUDIO_MODEL=Qwen3-ASR-0.6B
# XINFERENCE_AUDIO_FILE=/path/to/audio.mp3

# Optional provider keys for perf_reranker.py
# DeepSeek streaming LLM: model may also be selected explicitly with --model
DEEPSEEK_API_KEY=replace-with-your-api-key
DEEPSEEK_LLM_URL=https://api.deepseek.com/chat/completions
SILICONFLOW_API_KEY=replace-with-your-api-key
ALIYUN_API_KEY=replace-with-your-api-key
# Optional overrides for text Embedding (OpenAI-compatible API)
ALIYUN_EMBEDDING_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
ALIYUN_EMBEDDING_MODEL=text-embedding-v4
ALIYUN_RERANK_URL=https://your-instance/compatible-api/v1/reranks
XUNFEI_API_KEY=replace-with-your-api-key
HUAWEIYUN_API_KEY=replace-with-your-api-key
HUAWEIYUN_EMBEDDING_URL=https://api.modelarts-maas.com/v1/embeddings
HUAWEIYUN_EMBEDDING_MODEL=bge-m3
XUNFEI_EMBEDDING_URL=https://maas-api.cn-huabei-1.xf-yun.com/v2/embeddings
# Fill in the deployed model ID from the Xingchen MaaS console.
XUNFEI_EMBEDDING_MODEL=

# Dify knowledge base retrieval and streaming chat benchmarks
DIFY_BASE_URL=https://your-dify-host
DIFY_DATASET_ID=replace-with-your-dataset-id
DIFY_DATASET_API_KEY=replace-with-your-dataset-api-key
DIFY_CHAT_API_KEY=replace-with-your-chat-app-api-key
DIFY_QUERY=What is in the knowledge base?

# Web console (recommended for server deployment).
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this value stable; changing it makes encrypted API keys unreadable.
# BENCHMARK_SECRET_KEY=replace-with-generated-fernet-key
# BENCHMARK_DATA_DIR=/data
# BENCHMARK_CORS_ORIGINS=https://benchmarks.example.com
# Audio transcription presets (server must serve a speech-to-text model)
VLLM_AUDIO_URL=
VLLM_AUDIO_MODEL=
SILICONFLOW_AUDIO_URL=https://api.siliconflow.cn/v1/audio/transcriptions
SILICONFLOW_AUDIO_MODEL=FunAudioLLM/SenseVoiceSmall
