{
  "name": "perflab-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test:dashboard": "tsc --ignoreConfig src/dashboardData.ts --outDir ../output/frontend-tests --module commonjs --target ES2022 --skipLibCheck && node ../tests/frontend/test_dashboard_data.cjs ../output/frontend-tests",
    "test:playground": "tsc --ignoreConfig src/api.ts --outDir ../output/frontend-tests --module commonjs --target ES2022 --skipLibCheck && node ../tests/frontend/test_playground_stream.cjs ../output/frontend-tests",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "echarts": "^6.1.0",
    "lucide-react": "^1.49.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
